# 无密钥演示（不会调用外部模型）
ECHOMIND_MODE=demo
ECHOMIND_STORAGE=local
API_HOST=127.0.0.1
API_PORT=8000
PROMETHEUS_PORT=0
# 默认 data/finance.sqlite3，存储模拟记录/工单/本地对话
# ECHOMIND_DB_PATH=./data/finance.sqlite3

# 模型模式：ECHOMIND_MODE=llm，必须明确填写提供商支持的模型
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=
# ECHOMIND_PRODUCT_MODEL=
# ECHOMIND_GENERAL_MODEL=

# 管理员导入资料、重载 Skills、手动评测用；未配置时禁用写入运营入口
ECHOMIND_ADMIN_TOKEN=
# 保留的分布式存储路径：ECHOMIND_STORAGE=distributed
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
# Webhook 默认关闭；只有明确配置并启用时才发送外部通知
ECHOMIND_ENABLE_WEBHOOK=0
